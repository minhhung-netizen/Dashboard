# Optional. When set, TradingView webhook payloads must include this value
# as either ?secret=... or {"secret": "..."}.
WEBHOOK_SECRET=change-me

# SQLite database path. Relative paths are resolved from the project root.
DATABASE_PATH=data/signals.db

# Refresh prices for open positions while the Vietnamese market is open.
PRICE_REFRESH_MINUTES=120
MARKET_SESSIONS=09:00-11:30,13:00-15:00

# Vnstock free-tier request control. Current public docs mention 60 requests/minute
# and 3000 requests/hour, but this app stays well below that by caching each ticker
# and spacing API calls.
VNSTOCK_CACHE_TTL_MINUTES=240
VNSTOCK_MIN_REQUEST_INTERVAL_SECONDS=4
VNSTOCK_LOOKBACK_DAYS=90
VNSTOCK_INCLUDE_METRICS=false

# When TradingView repeats the same alert, ignore it instead of inserting
# another signal. If payload "time" is present, the app uses exact candle time.
# If not, it uses this rolling window.
DUPLICATE_WINDOW_MINUTES=5
