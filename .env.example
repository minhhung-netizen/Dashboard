# SQLite location. Railway: attach one persistent Volume at /data and use this value.
DATABASE_PATH=data/backtests.db

# A single administrator protects the research workspace.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
SESSION_DAYS=30

# TradingView calls POST /webhook with this same secret in its JSON body.
# Railway production should keep enforcement enabled.
WEBHOOK_SECRET=replace-with-a-long-random-secret
REQUIRE_WEBHOOK_SECRET=true

# Used only by the local backtest CLI to upload a completed report through
# POST /api/backtests/import. Keep it separate from your admin password.
BACKTEST_UPLOAD_TOKEN=replace-with-a-separate-long-random-token
